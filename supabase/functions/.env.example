# Server-only values. Never use a VITE_ prefix.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
VENUE_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=YOUR_FREE_TAVILY_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Optional override. Default requires Gemini 2.5 access on the Google project.
GEMINI_VENUE_MODEL=gemini-2.5-flash-lite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
